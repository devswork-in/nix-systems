#!/usr/bin/env bash
# Locate the working nix-systems repository without mutating /etc/nixos.

set -euo pipefail

CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/nix-systems-repo"
HOSTNAME="$(hostname)"
TARGET_CONFIG="hosts/${HOSTNAME}"

# Validate cached repo path
validate_repo() {
    local repo="$1"
    [[ -n "$repo" ]] && [[ -f "$repo/flake.nix" ]] && [[ -e "$repo/$TARGET_CONFIG" ]]
}

# Discover repo by searching for flake.nix that contains hostname config
discover_repo() {
    local found=""
    local newest_time=0

    # Prefer the current Git worktree.
    local current
    current="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    if validate_repo "$current"; then
        echo "$current"
        return
    fi

    # Fall back to a bounded home-directory search.
    while IFS= read -r flake; do
        local dir
        dir="$(dirname "$flake")"
        if [[ -e "$dir/$TARGET_CONFIG" ]]; then
            # Pick the most recently modified one if multiple found
            local mtime
            mtime=$(stat -c %Y "$dir/flake.nix" 2>/dev/null || echo 0)
            if [[ "$mtime" -gt "$newest_time" ]]; then
                newest_time="$mtime"
                found="$dir"
            fi
        fi
    done < <(find "$HOME" -maxdepth 4 -name "flake.nix" -not -path "*/\.*" 2>/dev/null | head -20)

    echo "$found"
}

# Main sync logic
main() {
    local repo=""

    # Try cache first
    if [[ -f "$CACHE_FILE" ]]; then
        repo="$(cat "$CACHE_FILE")"
        if ! validate_repo "$repo"; then
            repo=""
        fi
    fi

    # Re-discover if cache invalid
    if [[ -z "$repo" ]]; then
        repo="$(discover_repo)"
        if [[ -z "$repo" ]]; then
            echo "ERROR: Could not find nix-systems repo containing $TARGET_CONFIG" >&2
            echo "Searched under $HOME for flake.nix + $TARGET_CONFIG" >&2
            exit 1
        fi
        # Update cache
        mkdir -p "$(dirname "$CACHE_FILE")"
        echo "$repo" > "$CACHE_FILE"
        echo "INFO: Discovered nix-systems repo at $repo" >&2
    fi

    echo "$repo"
}

main "$@"
