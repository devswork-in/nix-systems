#!/bin/sh
# Portable universal file previewer and opener
# Optimized for Wayland, Kitty, and POSIX shells

show_help() {
    echo "v - Portable universal file previewer"
    echo "Usage: v [file|url|directory]"
}

case "$1" in
    -h|--help)
        show_help
        exit 0
        ;;
esac

# 1. URL handling
case "$1" in
    http://*|https://*)
        if command -v awrit >/dev/null 2>&1; then
            awrit "$1" >/dev/null 2>&1 &
        else
            xdg-open "$1" >/dev/null 2>&1 &
        fi
        exit 0
        ;;
esac

# 2. No arguments: interactive fzf launcher
if [ "$#" -eq 0 ]; then
    if command -v fzf >/dev/null 2>&1; then
        find_cmd="find . -maxdepth 4 -not -path '*/.*'"
        if command -v fd >/dev/null 2>&1; then
            find_cmd="fd --hidden --exclude .git --exclude node_modules"
        fi

        selection=$(eval "$find_cmd" | fzf \
            --multi \
            --preview '
                if [ -d {} ]; then tree -C -L 2 {} 2>/dev/null || ls -la {};
                elif echo {} | grep -Eq "\.(md|markdown)$"; then glow -s dark {} 2>/dev/null || bat --color=always {};
                elif echo {} | grep -Eq "\.json$"; then jq -C . {} 2>/dev/null | head -n 100;
                elif command -v bat >/dev/null 2>&1; then bat --color=always --style=numbers {};
                else cat {}; fi' \
            --preview-window=right:60%:wrap \
            --bind="ctrl-e:execute(nvim {})" \
            --bind="ctrl-y:execute-silent(printf %s {} | wl-copy)" \
            --header="Enter: preview | Ctrl-E: edit | Ctrl-Y: copy path")

        if [ -n "$selection" ]; then
            for item in $selection; do
                "$0" "$item"
            done
        fi
        exit 0
    else
        ls -la
        exit 0
    fi
fi

ARG="$1"

if [ ! -e "$ARG" ]; then
    echo "v: '$ARG': No such file or directory" >&2
    exit 1
fi

# 3. Directory preview
if [ -d "$ARG" ]; then
    if command -v tree >/dev/null 2>&1; then
        tree -C -L 2 "$ARG" | head -n 40
    else
        ls -la "$ARG"
    fi
    exit 0
fi

# 4. MIME type preview
MIME=$(file --mime-type -b "$ARG" 2>/dev/null)

case "$MIME" in
    image/*)
        if command -v swiv >/dev/null 2>&1; then
            swiv "$ARG" >/dev/null 2>&1 &
        elif command -v sxiv >/dev/null 2>&1; then
            sxiv "$ARG" >/dev/null 2>&1 &
        elif [ -n "$KITTY_WINDOW_ID" ]; then
            kitty +kitten icat "$ARG"
        elif command -v imv >/dev/null 2>&1; then
            imv "$ARG" >/dev/null 2>&1 &
        fi
        ;;
    video/*|audio/*)
        if command -v mpv >/dev/null 2>&1; then
            mpv "$ARG" >/dev/null 2>&1 &
        fi
        ;;
    application/pdf)
        if command -v zathura >/dev/null 2>&1; then
            zathura "$ARG" >/dev/null 2>&1 &
        fi
        ;;
    application/zip|application/x-tar|application/x-compressed-tar|application/x-gzip|application/x-xz)
        if echo "$ARG" | grep -Eq "\.zip$" && command -v unzip >/dev/null 2>&1; then
            unzip -l "$ARG"
        elif command -v tar >/dev/null 2>&1; then
            tar -tvf "$ARG"
        fi
        ;;
    *)
        case "$ARG" in
            *.md|*.MD)
                if command -v glow >/dev/null 2>&1; then
                    glow -s dark "$ARG"
                elif command -v bat >/dev/null 2>&1; then
                    bat --color=always "$ARG"
                else
                    less "$ARG"
                fi
                ;;
            *.json|*.JSON)
                if command -v jq >/dev/null 2>&1; then
                    jq -C . "$ARG" 2>/dev/null | head -n 100
                elif command -v bat >/dev/null 2>&1; then
                    bat --color=always "$ARG"
                else
                    less "$ARG"
                fi
                ;;
            *)
                if command -v bat >/dev/null 2>&1; then
                    bat --color=always --style=numbers "$ARG"
                else
                    less "$ARG"
                fi
                ;;
        esac
        ;;
esac
